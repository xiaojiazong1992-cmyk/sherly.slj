   "source": [
    "# 01 真实数据采集\n",
    "**论文章节对应**：第2章 数据来源与采集\n",
    "\n",
    "本notebook完成以下任务：\n",
    "1. 从国家统计局NBS爬取分省房屋竣工造价（主力数据源）\n",
    "2. 从全国公共资源交易平台爬取住宅工程中标数据（补充数据）\n",
    "3. 构建螺纹钢、水泥年度价格指数\n",
    "4. 合并数据并保存原始文件\n",
    "\n",
    "**输出**：\n",
    "- `data/raw/housing_cost_raw.csv`\n",
    "- `data/external/material_prices.csv`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.insert(0, '..')  # 使src/模块可以被导入\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from pathlib import Path\n",
    "\n",
    "# 导入数据爬取模块\n",
    "from src.data_scraper import (\n",
    "    fetch_nbs_construction_cost,\n",
    "    fetch_ggzy_bid_results,\n",
    "    get_material_price_df,\n",
    "    generate_fallback_data,\n",
    ")\n",
    "\n",
    "# 创建输出目录\n",
    "Path('data/raw').mkdir(parents=True, exist_ok=True)\n",
    "Path('data/external').mkdir(parents=True, exist_ok=True)\n",
    "Path('data/processed').mkdir(parents=True, exist_ok=True)\n",
    "Path('outputs/figures').mkdir(parents=True, exist_ok=True)\n",
    "Path('outputs/saved_models').mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "print('环境准备完毕 ✓')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1.1 国家统计局数据采集\n",
    "指标：各省房屋竣工造价（元/㎡），覆盖2020-2025年"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('正在从国家统计局API获取分省造价数据...')\n",
    "df_nbs = fetch_nbs_construction_cost(retries=3, delay=2)\n",
    "\n",
    "if not df_nbs.empty:\n",
    "    print(f'\\nNBS数据采集成功！共 {len(df_nbs)} 条')\n",
    "    print(df_nbs.head(10))\n",
    "    print(f'\\n年份范围: {df_nbs[\"year\"].min()} ~ {df_nbs[\"year\"].max()}')\n",
    "    print(f'省份数量: {df_nbs[\"province\"].nunique()}')\n",
    "    print(f'造价范围: {df_nbs[\"unit_cost\"].min():.0f} ~ {df_nbs[\"unit_cost\"].max():.0f} 元/㎡')\n",
    "else:\n",
    "    print('NBS数据采集失败，将使用备用数据方案')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1.2 全国公共资源交易平台补充数据"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('正在从全国公共资源交易平台爬取住宅中标数据...')\n",
    "print('（注：平台存在反爬机制，如失败会自动减少页数）')\n",
    "\n",
    "df_ggzy = fetch_ggzy_bid_results(keyword='住宅', max_pages=10)\n",
    "\n",
    "if not df_ggzy.empty:\n",
    "    print(f'\\nGGZY数据采集成功！共 {len(df_ggzy)} 条')\n",
    "    print(df_ggzy.head())\n",
    "else:\n",
    "    print('GGZY数据采集失败（常见，平台限制严格）')\n",
    "    df_ggzy = pd.DataFrame()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1.3 数据合并与补全策略\n",
    "\n",
    "由于NBS数据只有省级粒度，缺少工程技术特征（结构类型、层数等），\n",
    "需要结合真实统计规律进行特征扩展，或补充GGZY个体项目数据。\n",
    "\n",
    "数据量不足300条时：在论文"研究局限性"章节注明，并启用合成备用数据。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 合并策略 ──────────────────────────────────────\n",
    "# 优先级：GGZY项目级数据 > NBS省级汇总数据 > 合成备用数据\n",
    "\n",
    "# 1. 将NBS省级数据扩展为含技术特征的项目级记录\n",
    "def expand_nbs_to_projects(df_nbs, projects_per_row=3, random_state=42):\n",
    "    \"\"\"\n",
    "    将NBS省级年度造价数据扩展为模拟项目级数据\n",
    "    每条NBS记录扩展为若干条含工程技术特征的记录\n",
    "    注意：技术特征基于统计分布生成，非个体真实数据\n",
    "    \"\"\"\n",
    "    rng = np.random.RandomState(random_state)\n",
    "    \n",
    "    struct_types  = ['框架', '剪力墙', '框剪', '砌体']\n",
    "    struct_probs  = [0.25, 0.45, 0.20, 0.10]\n",
    "    found_types   = ['桩基础', '筏板基础', '独立基础', '条形基础']\n",
    "    housing_types = ['普通住宅', '高档住宅', '保障房', '别墅']\n",
    "    housing_probs = [0.50, 0.20, 0.25, 0.05]\n",
    "\n",
    "    records = []\n",
    "    for _, row in df_nbs.iterrows():\n",
    "        for _ in range(projects_per_row):\n",
    "            above_floors = rng.randint(3, 34)\n",
    "            total_area   = rng.uniform(5000, 80000)\n",
    "            # 省级均价 ± 15% 扰动模拟项目差异\n",
    "            unit_cost    = row['unit_cost'] * rng.uniform(0.85, 1.15)\n",
    "            \n",
    "            records.append({\n",
    "                'province':          row['province'],\n",
    "                'completion_year':   int(row['year']),\n",
    "                'total_area':        round(total_area, 1),\n",
    "                'above_floors':      above_floors,\n",
    "                'under_floors':      rng.randint(0, 3),\n",
    "                'structure_type':    rng.choice(struct_types, p=struct_probs),\n",
    "                'foundation_type':   rng.choice(found_types),\n",
    "                'seismic_intensity': rng.choice([6, 7, 8], p=[0.3, 0.5, 0.2]),\n",
    "                'is_prefab':         int(rng.random() < 0.18),\n",
    "                'decoration_level':  rng.choice([0, 1, 2, 3], p=[0.3, 0.3, 0.3, 0.1]),\n",
    "                'housing_type':      rng.choice(housing_types, p=housing_probs),\n",
    "                'unit_cost':         round(unit_cost, 2),\n",
    "                'data_source':       'NBS_expanded',\n",
    "            })\n",
    "    return pd.DataFrame(records)\n",
    "\n",
    "\n",
    "# 执行扩展\n",
    "if not df_nbs.empty:\n",
    "    df_expanded = expand_nbs_to_projects(df_nbs, projects_per_row=3)\n",
    "    print(f'NBS数据扩展后：{len(df_expanded)} 条')\n",
    "else:\n",
    "    df_expanded = pd.DataFrame()\n",
    "\n",
    "# 合并所有来源数据\n",
    "all_dfs = []\n",
    "if not df_expanded.empty:\n",
    "    all_dfs.append(df_expanded)\n",
    "if not df_ggzy.empty:\n",
    "    all_dfs.append(df_ggzy)\n",
    "\n",
    "if all_dfs:\n",
    "    df_raw = pd.concat(all_dfs, ignore_index=True)\n",
    "else:\n",
    "    df_raw = pd.DataFrame()\n",
    "\n",
    "print(f'当前数据总量: {len(df_raw)} 条')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 数据量不足时启用备用数据 ──────────────────────────\n",
    "MIN_SAMPLES = 300\n",
    "\n",
    "if len(df_raw) < MIN_SAMPLES:\n",
    "    shortfall = MIN_SAMPLES - len(df_raw)\n",
    "    print(f'⚠ 数据量不足（{len(df_raw)}条 < {MIN_SAMPLES}条）')\n",
    "    print(f'  启用合成备用数据补充 {shortfall} 条')\n",
    "    print('  注意：将在论文\"研究局限性\"章节注明此情况')\n",
    "    \n",
    "    df_fallback = generate_fallback_data(n=max(shortfall, MIN_SAMPLES), random_state=42)\n",
    "    \n",
    "    if df_raw.empty:\n",
    "        df_raw = df_fallback\n",
    "    else:\n",
    "        df_raw = pd.concat([df_raw, df_fallback.head(shortfall)], ignore_index=True)\n",
    "\n",
    "print(f'\\n最终数据集: {len(df_raw)} 条')\n",
    "print(f'数据来源分布:\\n{df_raw[\"data_source\"].value_counts()}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1.4 材料价格指数"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 获取材料价格指数\n",
    "df_material = get_material_price_df()\n",
    "print('材料价格指数（以2020年为基期=100）：')\n",
    "print(df_material.to_string(index=False))\n",
    "\n",
    "# 保存材料价格数据\n",
    "df_material.to_csv('data/external/material_prices.csv', index=False, encoding='utf-8-sig')\n",
    "print('\\n已保存至 data/external/material_prices.csv')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1.5 合并材料价格指数 & 保存原始数据"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 将材料价格指数合并到主数据（按竣工年份关联）\n",
    "df_raw = df_raw.merge(\n",
    "    df_material.rename(columns={'year': 'completion_year'}),\n",
    "    on='completion_year',\n",
    "    how='left',\n",
    ")\n",
    "\n",
    "# 如果已有这些列（来自generate_fallback_data），用合并值覆盖确保一致\n",
    "if 'steel_price_index_x' in df_raw.columns:\n",
    "    df_raw['steel_price_index']  = df_raw['steel_price_index_y'].fillna(df_raw['steel_price_index_x'])\n",
    "    df_raw['cement_price_index'] = df_raw['cement_price_index_y'].fillna(df_raw['cement_price_index_x'])\n",
    "    df_raw.drop(columns=[c for c in df_raw.columns if c.endswith('_x') or c.endswith('_y')], \n",
    "                inplace=True, errors='ignore')\n",
    "    df_raw['steel_price_index']  = df_raw.get('steel_price_index', df_raw.get('steel_price_index_y'))\n",
    "    df_raw['cement_price_index'] = df_raw.get('cement_price_index', df_raw.get('cement_price_index_y'))\n",
    "\n",
    "print('数据字段：', df_raw.columns.tolist())\n",
    "print(f'\\n数据规模: {df_raw.shape}')\n",
    "print('\\n前5条记录：')\n",
    "df_raw.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 保存原始数据\n",
    "df_raw.to_csv('data/raw/housing_cost_raw.csv', index=False, encoding='utf-8-sig')\n",
    "print(f'✓ 原始数据已保存至 data/raw/housing_cost_raw.csv')\n",
    "print(f'  记录数: {len(df_raw)}')\n",
    "print(f'  字段数: {len(df_raw.columns)}')\n",
    "print(f'  年份范围: {df_raw[\"completion_year\"].min()} ~ {df_raw[\"completion_year\"].max()}')\n",
    "print(f'  省份数量: {df_raw[\"province\"].nunique()}')\n",
    "print(f'  单方造价: {df_raw[\"unit_cost\"].min():.0f} ~ {df_raw[\"unit_cost\"].max():.0f} 元/㎡')"
   ]
  },
